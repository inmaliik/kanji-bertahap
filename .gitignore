# macOS / editor clutter
.DS_Store
Thumbs.db

# Participant data must never be committed.
# Log exports from the Settings screen, and any other CSV except the five content templates.
*.csv
!tools/templates/*.csv
exports/
logs/

# Team source material (documents, original artwork). Not part of the app; never uploaded.
sumber/

# Netlify publish folder, rebuilt by terbitkan.sh on every deploy (D-115)
_situs/

# Temporary test folders (e.g. 30-level dummy content)
tmp/
.tmp/
test-data/

# In case someone runs npm by habit; the app itself has no dependencies.
node_modules/
